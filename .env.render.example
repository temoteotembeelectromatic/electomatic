DATABASE_URL=postgresql://user:password@host:5432/electomatic
# Enable certificate-verified TLS for external database connections if needed.
DATABASE_SSL=false
AWS_REGION=your-bucket-region
S3_BUCKET=your-existing-bucket
S3_PREFIX=electomatic/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ADMIN_EMAIL=owner@example.com
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
# Render supplies RENDER_EXTERNAL_URL. Set APP_URL only for a custom domain.
APP_URL=http://127.0.0.1:10000
PORT=10000
NODE_ENV=development
# Optional for buckets requiring KMS or other S3-compatible services:
# S3_SSE=aws:kms
# S3_KMS_KEY_ID=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
